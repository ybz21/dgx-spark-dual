# Entrpi glm-5.3-flash-exl3-2x-spark 的 .env，已按 .8 / .12 两台实机填好。
# 用法：在 head(.8) 上 clone 该 kit 后 `cp 本文件 .env`，再 ./install.sh。
# 注意：这里只覆盖必须改的项，serving 旋钮一律留空跟随 kit 的验证过默认值。

# --- 两台机器 ---------------------------------------------------------------
WORKER_LAN_IP=192.168.130.12
WORKER_USER=ai

# 200GbE 直连光缆。注意本地实际用的是第二个口 f1，不是 kit 默认的 f0；
# IP 也不是 kit 示例的 10.200.0.x，而是本仓库既有的 10.0.0.x。
HEAD_RAIL_IP=10.0.0.2
WORKER_RAIL_IP=10.0.0.3
HEAD_NCCL_IF=enp1s0f1np1
HEAD_NCCL_HCA=rocep1s0f1
WORKER_NCCL_IF=enp1s0f1np1
WORKER_NCCL_HCA=rocep1s0f1
NCCL_SUBNET=10.0.0.0/24

# --- 权重 -------------------------------------------------------------------
# 两台各存一份（各 164 GiB），走 local 模式；权重已由本目录 scripts/ 下的
# 脚本从 ModelScope 拉好并 sha256 校验过，install.sh 用 --skip-download 即可。
WEIGHTS_MODE=local
MODEL_HOST_PATH=/home/ai/models/GLM-5.3-Flash-EXL3-TR3-4bpw
DFLASH_DIR=/home/ai/models/glm53-dflash2-mxfp8
DFLASH_REPO=local-inference-lab/GLM-5.3-Flash-DFlash2-MXFP8

# --- 镜像 -------------------------------------------------------------------
# 留空 = 跟随 kit 当前发行版（v2.3-tier1）。别钉旧 tag，launcher 会拒。
#IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2.3-tier1

# --- serving 旋钮 -----------------------------------------------------------
# 全部留空 = kit 验证过的生产默认：524K 上下文、1,287,194 token KV 池、
# fp8_ds_mla、DFlash2 投机、KV_CACHE_MEMORY=14.4e9、GMU=0.85。
# 我们这两台是常驻业务机，起服务前请先按 docs/现场勘察 腾内存；
# 如果实在腾不到 <6 GB，先调小 KV_CACHE_MEMORY（每 1 GB ≈ 9 万 token 池），
# 不要直接把 MEM_USED_MAX_GB 关掉 —— Spark 统一内存超售不会优雅降级，会直接崩。
#KV_CACHE_MEMORY=
#MEM_USED_MAX_GB=6
#PORT=8000

# --- 本地实机调整 (.8 是常驻业务机，起服务时系统内存占用约 7 GB) ---
# kit 默认要求 <6 GB。这里把上限抬到 8 GB，同时把 KV 预算从 14.4 GB 降到 12.4 GB
# 补偿回去（每 1 GB 约 9 万 token 池），净效果是给系统多留 1 GB 余量。
# 不用 MEM_USED_MAX_GB=0 关检查——Spark 统一内存超售不会优雅降级，是直接崩。
MEM_USED_MAX_GB=8
KV_CACHE_MEMORY=12400000000   # 必须纯整数，科学计数法 vllm 不认
