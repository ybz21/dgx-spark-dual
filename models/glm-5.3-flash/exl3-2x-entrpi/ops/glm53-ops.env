# GLM-5.3-Flash 运维层配置。两台放同一份，被 rail / supervisor 脚本读取。
# 这里只放"我们自己的"决策，Entrpi kit 的 serving 旋钮见下面 PROFILE_*。

# --- 两台的身份（按管理网 IP 判角色，不依赖 hostname）---
HEAD_LAN_IP=192.168.130.8
WORKER_LAN_IP=192.168.130.12
SSH_USER=ai

# --- 光缆直连网段。脚本会自动挑通的那个口并配上这两个地址 ---
RAIL_SUBNET=10.0.0
RAIL_PREFIX=24
HEAD_RAIL_IP=10.0.0.2
WORKER_RAIL_IP=10.0.0.3

# 候选光口，按顺序试。四个口都列上，插哪个都能认。
RAIL_CANDIDATES="enp1s0f1np1 enp1s0f0np0 enP2p1s0f1np1 enP2p1s0f0np0"

# --- serving 档位：1M 原生上下文 ---
# fp8 KV 撑不住 1M，必须同时开 NVFP4 注意力内存。
# 实测 KV 池 1,613,717 token，满长并发 1.54x。
# 换回 512K：把 PROFILE_KV_DTYPE 改回 fp8_ds_mla、MAX_LEN 改 524288、MNBT 改 8192。
PROFILE_KV_DTYPE=nvfp4_ds_mla
PROFILE_NVFP4_DYNAMIC_SCALE=1
PROFILE_MAX_LEN=1048576
PROFILE_MNBT=4096
# .8 是常驻业务机，起服务前系统占用约 6-7 GB，kit 默认限 6 GB。
# 抬上限的同时把 KV 预算从 14.4 GB 降到 12.4 GB 补偿，用自己的池子换系统余量。
PROFILE_KV_CACHE_MEMORY=12400000000
PROFILE_MEM_USED_MAX_GB=8

PORT=8000
IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2.3-tier1
