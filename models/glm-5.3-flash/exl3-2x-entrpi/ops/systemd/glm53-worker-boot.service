[Unit]
Description=GLM-5.3-Flash worker 侧开机占位（真正的启动由 head 的 supervisor 编排）
# 故意不在这里起容器：启动顺序要求 head 先删容器、worker 再起，
# 两台各自开机自启会打乱顺序。这里只保证光口配好、docker 在跑，
# 然后等 head 的 supervisor 通过 SSH 来编排。
After=network-online.target docker.service glm53-rail.service
Wants=glm53-rail.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 开机先把上一次的残留容器清掉，避免 head 来编排时撞上旧进程
ExecStart=/usr/bin/docker rm -f vllm_glm53
ExecStart=/bin/true

[Install]
WantedBy=multi-user.target
